# ==========================================
# Solana Flash Swap - Configuration Template
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env or wallet keypairs to version control!

# 1. Helius RPC API Key (Required for high-speed primary RPC)
# Sign up at: https://helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# 2. Backup Solana RPC URL (Fallback and dual-broadcasting)
BACKUP_RPC_URL=https://api.mainnet-beta.solana.com

# 3. Jupiter API Key (Optional: for higher rate limits)
# Get your API key from: https://jup.ag
JUPITER_API_KEY=

# 4. Path to your Solana Keypair JSON file
WALLET_PATH=./my-wallet.json

# 5. Default Slippage in Basis Points (50 = 0.5%, 100 = 1.0%)
SLIPPAGE_BPS=50
